#!/usr/bin/env bash
# ============================================================================
#  /usr/local/sbin/mrog-lease-kill - destroy the ROOT lease. Nothing else.
#
#  The twin of mrog-input-kill, byte for byte in spirit (REVIEW.md finding 4,
#  FLEET-4HY 2026-09-17). Until it existed the design principle "stopping is
#  free, starting is not" held for the input lease only: ending a root lease
#  went through `sudo mrog-lease revoke` or a pkexec dialog -- a password on
#  the way to STOPPING root.
#
#  It takes no arguments, reads no input, and its entire effect is to delete
#  one fixed path. Safe to hand out without a password because:
#    - It can only ever END root access. An agent that calls it de-privileges
#      itself.
#    - Granting a new lease still costs Chris's password: mrog-lease is NOT
#      in any NOPASSWD rule.
#  /run/mrog is root-owned, so nothing short of this helper can delete the
#  lease, and this helper can delete nothing else.
# ============================================================================
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "mrog-lease-kill: root only"; exit 1; }
[[ $# -eq 0 ]] || { echo "mrog-lease-kill: takes no arguments"; exit 1; }

LEASE=/run/mrog/lease.json

if [[ -f $LEASE ]]; then
    rm -f "$LEASE" /run/mrog/shell-warned
    logger -t mrog "ROOT LEASE KILLED by ${SUDO_USER:-root} via mrog-lease-kill"
    echo "root lease destroyed"
else
    logger -t mrog "ROOT LEASE KILL requested by ${SUDO_USER:-root} - none was live"
    echo "no root lease was live"
fi
